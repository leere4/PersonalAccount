@model PersonalAccount.Models.StudentEditViewModel

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <h2 class="text-center mb-4">Редактирование профиля</h2>

            <form method="post" asp-controller="Cabinet" asp-action="Edit">
                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="mb-3">
                    <label asp-for="FullName" class="form-label">ФИО</label>
                    <input asp-for="FullName" class="form-control" />
                    <span asp-validation-for="FullName" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="GroupName" class="form-label">Группа</label>
                    <input asp-for="GroupName" class="form-control" />
                    <span asp-validation-for="GroupName" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="PhotoUrl" class="form-label">Ссылка на фото</label>
                    <input asp-for="PhotoUrl" class="form-control" placeholder="https://example.com/photo.jpg" />
                    <span asp-validation-for="PhotoUrl" class="text-danger"></span>
                </div>

                <div class="d-grid gap-2">
                    <button type="submit" class="btn btn-success">Сохранить</button>
                    <a asp-controller="Cabinet" asp-action="Index" class="btn btn-outline-secondary">Отмена</a>
                </div>
            </form>
        </div>
    </div>
</div>